{% from "../../macros/attributes.njk" import govukAttributes %}

{%- if params.type == "success" %}
  {% set successBanner = true %}
{% endif %}

{%- if params.type == "warning" %}
  {% set warningBanner = true %}
{% endif %}

{%- if params.type == "alert" %}
  {% set alertBanner = true %}
{% endif %}

{%- if successBanner or warningBanner or alertBanner %}
  {% set typeClass = "govuk-notification-banner--" + params.type %}
{% endif %}

{%- if params.role %}
  {% set role = params.role %}
{% elif successBanner %}
  {% set role = "status" %}
{% elif warningBanner or alertBanner %}
  {% set role = "alert" %}
{% else %}
  {% set role = "region" %}
{% endif %}

{%- if params.titleHtml %}
  {% set title = params.titleHtml | safe %}
{%- elif params.titleText %}
  {% set title = params.titleText %}
{%- elif successBanner %}
  {% set title = "Success" %}
{%- elif warningBanner %}
  {% set title = "Warning" %}
{%- elif alertBanner %}
  {% set title = "Error" %}
{%- else %}
  {% set title = "Important" %}
{%- endif -%}

{%- if params.isSmall %}
  {% set isSmall = true %}
{% endif %}

{% set iconName = "info" %}
{% if successBanner %}
  {% set iconName = "check_circle" %}
{% elif warningBanner %}
  {% set iconName = "warning" %}
{% elif alertBanner %}
  {% set iconName = "error" %}
{% endif %}

<div class="govuk-notification-banner {%- if isSmall %} govuk-notification-banner--small {% endif %} {%- if typeClass %} {{ typeClass }}{% endif %}{% if params.classes %} {{ params.classes }}{% endif %}" role="{{ role }}" aria-labelledby="{{ params.titleId | default("govuk-notification-banner-title", true) }}" data-module="govuk-notification-banner"
  {%- if params.disableAutoFocus !== undefined %} data-disable-auto-focus="{{ params.disableAutoFocus }}"{% endif %}
  {{- govukAttributes(params.attributes) }}>
  
  <div class="govuk-notification-banner__inner">

    <div class="govuk-notification-banner__icon">
      <span class="material-icons" aria-hidden="true">{{ iconName }}</span>
    </div>

    <div class="govuk-notification-banner__header">
      <h{{ params.titleHeadingLevel | default(2, true) }} class="govuk-notification-banner__title" id="{{ params.titleId | default("govuk-notification-banner-title", true) }}">
        {{ title }}
      </h{{ params.titleHeadingLevel | default(2, true) }}>
    </div>

    <div class="govuk-notification-banner__content">
    {% if caller or params.html %}
      {{ caller() if caller else params.html | safe | trim | indent(6) }}
    {% elif params.text %}
      <p class="govuk-notification-banner__heading">
        {{ params.text | trim | indent(8) }}
      </p>
    {% endif %}
    </div>

    {% if params.actionHtml %}
      <div class="govuk-notification-banner__action">
        {{ params.actionHtml | safe }}
      </div>
    {% endif %}

  </div>
</div>